{
  "name": "fast-food",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "kill": "for /f \"tokens=5\" %a in ('netstat -aon ^| findstr :4000') do taskkill /PID %a /F",
    "fresh": "npm run kill & node ./bin/www"
  },
