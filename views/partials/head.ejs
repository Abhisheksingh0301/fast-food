<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — FastFood POS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 50:'#fff7ed', 100:'#ffedd5', 200:'#fed7aa', 300:'#fdba74', 400:'#fb923c', 500:'#f97316', 600:'#ea580c', 700:'#c2410c', 800:'#9a3412', 900:'#7c2d12' }
          }
        }
      }
    }
  </script>
  <style>
    [x-cloak] { display: none !important; }
    .menu-item-card:active { transform: scale(0.95); }
    .menu-item-card { transition: transform 0.1s, box-shadow 0.1s; }
    .added-flash { animation: flashGreen 0.4s ease; }
    @keyframes flashGreen { 0%,100% { background-color: white; } 50% { background-color: #d1fae5; } }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; }
    }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    /* Safe area support for notched phones */
    .safe-area-bottom { padding-bottom: env(safe-area-inset-bottom, 0); }
    @supports (padding-bottom: env(safe-area-inset-bottom)) {
      nav.safe-area-bottom { padding-bottom: max(8px, env(safe-area-inset-bottom)); }
    }
  </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans">
