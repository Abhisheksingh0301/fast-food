<div class="flex h-screen overflow-hidden">
  <!-- Desktop Sidebar (hidden on mobile) -->
  <aside class="hidden md:flex w-56 bg-gray-900 flex-col shrink-0 no-print">
    <div class="p-4 border-b border-gray-700">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-brand-500 rounded-lg flex items-center justify-center text-white font-bold text-sm">FF</div>
        <div>
          <div class="text-white font-bold text-sm leading-tight">FastFood</div>
          <div class="text-gray-400 text-xs">POS System</div>
        </div>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto py-3 px-2 space-y-0.5">
      <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors
         <%= locals.title && title === 'Dashboard' ? 'bg-brand-600 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Dashboard
      </a>
      <a href="/orders/new" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors
         <%= locals.title && title === 'New Order' ? 'bg-brand-600 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
        New Order
      </a>
      <a href="/orders" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors
         <%= locals.title && title === 'Order History' ? 'bg-brand-600 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Orders
      </a>
      <% if (locals.user && user && user.role === 'admin') { %>
      <div class="pt-2 pb-1 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Admin</div>
      <a href="/menu" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors
         <%= locals.title && title === 'Menu Items' ? 'bg-brand-600 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
        Menu
      </a>
      <a href="/categories" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors
         <%= locals.title && title === 'Categories' ? 'bg-brand-600 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A2 2 0 013 10V5a2 2 0 012-2z"/></svg>
        Categories
      </a>
      <a href="/reports/daily" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors
         <%= locals.title && title === 'Daily Report' ? 'bg-brand-600 text-white' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Reports
      </a>
      <% } %>
    </nav>

    <div class="p-3 border-t border-gray-700">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 bg-gray-600 rounded-full flex items-center justify-center text-white text-xs font-bold">
          <%= locals.user && user ? user.username[0].toUpperCase() : '?' %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-white text-xs font-medium truncate"><%= locals.user && user ? user.username : '' %></div>
          <div class="text-gray-400 text-xs capitalize"><%= locals.user && user ? user.role : '' %></div>
        </div>
      </div>
      <a href="/logout" class="block w-full text-center text-xs text-gray-400 hover:text-white transition-colors py-1">Sign out</a>
    </div>
  </aside>

  <!-- Main content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Top bar -->
    <header class="bg-white border-b border-gray-200 px-4 md:px-6 py-3 flex items-center justify-between shrink-0 no-print">
      <h1 class="text-base md:text-lg font-semibold text-gray-800"><%= title %></h1>
      <div class="flex items-center gap-2 md:gap-3 text-sm text-gray-500">
        <span id="currentTime" class="font-mono text-xs hidden sm:inline"></span>
        <a href="/orders/new" class="bg-brand-500 hover:bg-brand-600 text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">
          + Order
        </a>
      </div>
    </header>
    <script>
      function tick() { const el = document.getElementById('currentTime'); if(el) el.textContent = new Date().toLocaleTimeString('en-IN'); }
      tick(); setInterval(tick, 1000);
    </script>

    <!-- Flash messages -->
    <% if (locals.success && success && success.length > 0) { %>
    <div class="mx-3 md:mx-6 mt-3 bg-green-50 border border-green-200 text-green-800 px-4 py-2 rounded-lg text-sm flex items-center gap-2 no-print" id="flashSuccess">
      <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <%= success[0] %>
    </div>
    <script>setTimeout(() => { const el = document.getElementById('flashSuccess'); if(el) el.style.display='none'; }, 3000);</script>
    <% } %>
    <% if (locals.error && error && (Array.isArray(error) ? error.length > 0 : error)) { %>
    <div class="mx-3 md:mx-6 mt-3 bg-red-50 border border-red-200 text-red-800 px-4 py-2 rounded-lg text-sm flex items-center gap-2 no-print">
      <svg class="w-4 h-4 text-red-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
      <%= Array.isArray(error) ? error[0] : error %>
    </div>
    <% } %>

    <!-- Page content (pb-16 reserves space for mobile bottom nav) -->
    <main class="flex-1 overflow-y-auto pb-16 md:pb-0">
