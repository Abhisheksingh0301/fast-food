<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<div class="p-3 md:p-6 space-y-4 md:space-y-6">

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
      <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Today's Orders</div>
      <div class="text-3xl font-bold text-gray-900"><%= todayOrders.count %></div>
      <div class="text-xs text-gray-400 mt-1">Billed today</div>
    </div>
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
      <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Today's Revenue</div>
      <div class="text-3xl font-bold text-green-600">₹<%= Math.round(todayOrders.revenue).toLocaleString('en-IN') %></div>
      <div class="text-xs text-gray-400 mt-1">Including GST</div>
    </div>
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
      <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Menu Items</div>
      <div class="text-3xl font-bold text-gray-900"><%= totalItems.count %></div>
      <div class="text-xs text-gray-400 mt-1">Active items</div>
    </div>
    <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
      <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Categories</div>
      <div class="text-3xl font-bold text-gray-900"><%= totalCategories.count %></div>
      <div class="text-xs text-gray-400 mt-1">Food categories</div>
    </div>
  </div>

  <!-- Quick actions -->
  <div class="flex gap-3">
    <a href="/orders/new" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-colors flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      New Order
    </a>
    <a href="/orders" class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
      View All Orders
    </a>
    <% if (user && user.role === 'admin') { %>
    <a href="/reports/daily" class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
      Daily Report
    </a>
    <% } %>
  </div>

  <!-- Recent Orders -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="px-5 py-4 border-b border-gray-100">
      <h2 class="font-semibold text-gray-800">Recent Orders</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-xs text-gray-500 uppercase bg-gray-50">
            <th class="text-left px-5 py-3">Order #</th>
            <th class="text-left px-5 py-3">Customer</th>
            <th class="text-left px-5 py-3">Payment</th>
            <th class="text-right px-5 py-3">Amount</th>
            <th class="text-right px-5 py-3">Time</th>
            <th class="text-center px-5 py-3">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% if (recentOrders.length === 0) { %>
          <tr><td colspan="6" class="text-center py-8 text-gray-400">No orders yet today</td></tr>
          <% } %>
          <% recentOrders.forEach(o => { %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-5 py-3 font-mono text-xs font-medium text-gray-700"><%= o.order_number %></td>
            <td class="px-5 py-3 text-gray-600"><%= o.customer_name || '—' %></td>
            <td class="px-5 py-3">
              <span class="px-2 py-0.5 rounded-full text-xs font-medium
                <%= o.payment_method === 'Cash' ? 'bg-green-100 text-green-700' : o.payment_method === 'UPI' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700' %>">
                <%= o.payment_method %>
              </span>
            </td>
            <td class="px-5 py-3 text-right font-semibold text-gray-800">₹<%= o.total.toFixed(2) %></td>
            <td class="px-5 py-3 text-right text-xs text-gray-400"><%= new Date(o.created_at).toLocaleTimeString('en-IN', {hour:'2-digit',minute:'2-digit'}) %></td>
            <td class="px-5 py-3 text-center">
              <a href="/orders/<%= o.id %>/receipt" class="text-orange-500 hover:text-orange-700 text-xs font-medium">Receipt</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
