<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Error</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
  <div class="text-center">
    <div class="text-6xl font-bold text-orange-500 mb-3"><%= error.status || 500 %></div>
    <div class="text-xl text-white font-semibold mb-2"><%= message %></div>
    <a href="/dashboard" class="text-orange-400 hover:text-orange-300 text-sm">← Back to Dashboard</a>
  </div>
</body>
</html>
